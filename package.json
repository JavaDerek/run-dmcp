{
  "name": "run-dmcp",
  "version": "0.2.0",
  "description": "An MCP server for LLM-run interactive fiction where the server owns what is true - including when it was true. A continuation of DMCP.",
  "license": "MIT",
  "author": "Derek Ferguson",
  "repository": {
    "type": "git",
    "url": "https://github.com/JavaDerek/run-dmcp.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rpg": {
      "types": "./dist/rpg/index.d.ts",
      "default": "./dist/rpg/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "run-dmcp": "dist/bin/run-dmcp.js"
  },
  "scripts": {
    "build": "tsc && npm run build:client",
    "build:server": "tsc",
    "build:client": "cd client && npm run build",
    "start": "node dist/bin/run-dmcp.js",
    "dev": "tsx src/bin/run-dmcp.ts",
    "dev:client": "cd client && npm run dev",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:client": "cd client && npm run test",
    "test:all": "npm run test:run && npm run test:client -- run",
    "test:acceptance": "npm run build && playwright test",
    "test:acceptance:only": "playwright test",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^11.0.0",
    "express": "^5.0.1",
    "sharp": "^0.34.5",
    "uuid": "^10.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/sharp": "^0.31.1",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.51.0",
    "vitest": "^4.0.16"
  },
  "contributors": [
    "Shawn Rushefsky (DMCP, the project this continues)"
  ],
  "keywords": [
    "mcp",
    "interactive-fiction",
    "narrative",
    "timeline",
    "event-sourcing",
    "llm",
    "rpg"
  ],
  "files": [
    "dist/",
    "!dist/**/__tests__/**",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/test-setup.*",
    "README.md",
    "LICENSE"
  ]
}
