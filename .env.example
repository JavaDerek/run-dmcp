# DMCP Environment Variables
# Copy this file to .env and modify as needed

# HTTP Server Port
# The port for the web UI server
# Default: 3456 (also used when the value is not a port number)
DMCP_HTTP_PORT=3456

# No Web UI
# Set to 1 to run the MCP server without the web UI, so no port is bound.
# What a host that spawns this as a subprocess sets for it: a server it cannot
# close squats a port. 0, false and an empty value leave the web UI on.
# Default: unset (the web UI runs)
# DMCP_NO_HTTP=1

# Database Path
# Custom path to the SQLite database file
# Default: ~/.local/share/dmcp/games.db (follows XDG Base Directory spec),
#   but only when that directory already exists
# Fallback: ./data/games.db, relative to the current working directory of
#   the application -- never inside the installed package
# DMCP_DB_PATH=/path/to/your/games.db

# Log Level
# Controls the verbosity of logging output
# Options: debug, info, warn, error
# Default: info
DMCP_LOG_LEVEL=info

# XDG Base Directory (standard Linux/macOS path)
# Overrides the default data directory location
# Default: ~/.local/share
# XDG_DATA_HOME=/custom/data/path
